{
  "name": "room-reservation",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de reserva de salas que garante, no banco de dados, que duas reservas nunca ocupem o mesmo horário.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker-main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "race": "tsx scripts/race.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
